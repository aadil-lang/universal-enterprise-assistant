# =============================================================================
# Universal Enterprise HR & IT Assistant - Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure local secret values as required.

# Application Environment & Central Demonstration Configuration
APP_ENV=development
DEMO_FISCAL_YEAR=2026

# Authentication & Internal Security Secrets
JWT_SECRET_KEY=dev_insecure_jwt_secret_key_min_32_chars_12345
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
INTERNAL_MCP_SECRET=dev_insecure_internal_mcp_hmac_secret_min_32

# PostgreSQL Database Configuration (Consistent Development Baseline)
POSTGRES_DB=acme_assistant
POSTGRES_USER=acme_app
POSTGRES_PASSWORD=acme_secure_dev_pw_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://acme_app:acme_secure_dev_pw_2026@postgres:5432/acme_assistant

# ChromaDB Vector Store Configuration
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=company_policies

# Embedding Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# FastAPI Gateway Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Model Context Protocol (MCP) Server Configuration (Internal Only)
MCP_HOST=mcp-server
MCP_PORT=8001

# Next.js Web Frontend Configuration
WEB_HOSTNAME=0.0.0.0
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM Provider Configuration ('mock', 'gemini', 'openai', 'custom')
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
