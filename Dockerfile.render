FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements from both services
COPY apps/api/requirements.txt ./api-requirements.txt
COPY packages/mcp_server/requirements.txt ./mcp-requirements.txt

# Install combined dependencies
RUN pip install --no-cache-dir -r api-requirements.txt && \
    pip install --no-cache-dir -r mcp-requirements.txt

# Copy application source code
COPY apps/api ./apps/api
COPY packages/mcp_server ./packages/mcp_server
COPY infrastructure ./infrastructure
COPY scripts ./scripts

# Expose Render standard port
EXPOSE 10000

ENV PORT=10000
ENV PYTHONPATH="/app/apps/api:/app/packages/mcp_server"
ENV APP_ENV="production"

# Healthcheck on FastAPI endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:10000/health/live || exit 1

# Start unified runner (FastMCP + FastAPI)
CMD ["python", "scripts/start_render.py"]
