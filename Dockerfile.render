# Production Dockerfile for Render Free Deployment
# Co-locates FastAPI Orchestrator (Public) and FastMCP Tool Server (Private Loopback)
FROM python:3.12-slim

WORKDIR /app

# Prevent Python from writing .pyc files and enable unbuffered output
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install essential system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged runtime user
RUN groupadd -g 1000 appuser && \
    useradd -u 1000 -g appuser -s /bin/bash -m appuser

# Copy dependency specifications and install
COPY apps/api/requirements.txt ./api-requirements.txt
COPY packages/mcp_server/requirements.txt ./mcp-requirements.txt

RUN pip install --no-cache-dir -r ./api-requirements.txt && \
    pip install --no-cache-dir -r ./mcp-requirements.txt && \
    pip install --no-cache-dir "qdrant-client>=1.9.0"

# Copy application sources
COPY apps/api/app ./apps/api/app
COPY packages/mcp_server/app ./packages/mcp_server/app
COPY scripts/start_render.py ./scripts/start_render.py
COPY infrastructure ./infrastructure

# Set permissions
RUN chown -R appuser:appuser /app

# Switch to unprivileged runtime user
USER appuser

# Expose Render default port
EXPOSE 8000

# Health check against lightweight liveness probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health/live || exit 1

# Launch unified entrypoint
CMD ["python", "scripts/start_render.py"]
